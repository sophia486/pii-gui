{
  "taxonomy": [
    "account_number",
    "private_address",
    "private_date",
    "private_email",
    "private_person",
    "private_phone",
    "private_url",
    "secret"
  ],
  "regexRules": [
    {
      "kind": "private_email",
      "matchIdPrefix": "private-email",
      "replacement": "[PRIVATE_EMAIL]",
      "pattern": "\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b",
      "ignoreCase": true
    },
    {
      "kind": "private_phone",
      "matchIdPrefix": "private-phone",
      "replacement": "[PRIVATE_PHONE]",
      "pattern": "\\b01[016789][\\s.-]?\\d{3,4}[\\s.-]?\\d{4}\\b|\\+82[\\s.-]?10[\\s.-]?\\d{4}[\\s.-]?\\d{4}\\b|\\b0[789]0\\d{8}\\b|(?:\\+1[\\s.-]?|\\b1?[\\s.-]?)(?:\\(\\d{3}\\)|\\d{3})[\\s.-]?\\d{3}[\\s.-]?\\d{4}\\b|\\b0[2-9]\\d?[\\s.-]\\d{3,4}[\\s.-]\\d{4}\\b",
      "ignoreCase": false
    },
    {
      "kind": "private_url",
      "matchIdPrefix": "private-url",
      "replacement": "[PRIVATE_URL]",
      "pattern": "\\b(?:https?://|www\\.)[A-Z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*[A-Z0-9/#]",
      "ignoreCase": true
    },
    {
      "kind": "private_date",
      "matchIdPrefix": "private-date",
      "replacement": "[PRIVATE_DATE]",
      "pattern": "\\b(?:\\d{4}-\\d{2}-\\d{2}|\\d{1,2}/\\d{1,2}/\\d{2,4}|(?:jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:tember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\\s+\\d{1,2},?\\s+\\d{4})\\b",
      "ignoreCase": true
    },
    {
      "kind": "secret",
      "matchIdPrefix": "secret",
      "replacement": "[SECRET]",
      "pattern": "\\bsk_[A-Za-z0-9_]{12,}\\b|\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b|\\b(?:gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,255})\\b|\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b|-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----[\\s\\S]*?-----END (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----",
      "ignoreCase": false
    },
    {
      "kind": "account_number",
      "matchIdPrefix": "credit-card",
      "replacement": "[ACCOUNT_NUMBER]",
      "pattern": "\\b[0-9](?:[ -]?[0-9]){12,18}\\b",
      "ignoreCase": false,
      "validator": "luhn"
    },
    {
      "kind": "account_number",
      "matchIdPrefix": "kr-registration",
      "replacement": "[ACCOUNT_NUMBER]",
      "pattern": "\\b[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])-?[1-8][0-9]{6}\\b",
      "ignoreCase": false,
      "validator": "kr_registration"
    },
    {
      "kind": "account_number",
      "matchIdPrefix": "jp-my-number",
      "replacement": "[ACCOUNT_NUMBER]",
      "pattern": "\\b[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}\\b",
      "ignoreCase": false,
      "validator": "jp_my_number"
    },
    {
      "kind": "account_number",
      "matchIdPrefix": "jp-corporate",
      "replacement": "[ACCOUNT_NUMBER]",
      "pattern": "\\b[1-9][0-9]{12}\\b",
      "ignoreCase": false,
      "validator": "jp_corporate"
    },
    {
      "kind": "private_address",
      "matchIdPrefix": "jp-postal",
      "replacement": "[PRIVATE_ADDRESS]",
      "pattern": "〒[ \\t]*[0-9]{3}-?[0-9]{4}\\b",
      "ignoreCase": false
    }
  ]
}
